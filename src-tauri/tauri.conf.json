{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Convix",
  "identifier": "io.github.luz0gg.convix",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Convix",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Luz0gg",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Convertisseur de fichiers local : glisser, déposer, convertir.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyQzdCMTRCNTVDQTU1MUIKUldRYlZjcFZTN0hINGgzYXFVZlhuelZHSXJwWEZmVVd1SHlqQlBwS3Y0aDFmajUxeEF0TFhmaFAK",
      "endpoints": [
        "https://github.com/Luz0gg/convix/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

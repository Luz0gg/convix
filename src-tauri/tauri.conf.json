{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Convix",
  "version": "0.1.0",
  "identifier": "io.github.luz0gg.convix",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Convix",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Luz0gg",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Convertisseur de fichiers local : glisser, déposer, convertir.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}

; NSIS installer hooks (see tauri.conf.json > bundle.windows.nsis.installerHooks).
; Keep the extension list in sync with EXTENSIONS in src-tauri/src/shell_integration.rs.

!macro NSIS_HOOK_POSTUNINSTALL
  ; Remove the Explorer context menu written by the app (HKCU, per user),
  ; including the one from builds made under the old code name (ConvertIO).
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.png\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.png\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jpg\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jpg\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jpeg\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jpeg\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jfif\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.jfif\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.webp\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.webp\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.gif\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.gif\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.bmp\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.bmp\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.tif\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.tif\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.tiff\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.tiff\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.ico\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.ico\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.tga\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.tga\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.svg\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.svg\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mp3\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mp3\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.wav\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.wav\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.flac\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.flac\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m4a\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m4a\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.aac\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.aac\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.ogg\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.ogg\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.opus\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.opus\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.aif\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.aif\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.aiff\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.aiff\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mp4\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mp4\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m4v\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.m4v\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mov\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mov\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mkv\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.mkv\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.webm\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.webm\shell\ConvertIO"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.avi\shell\Convix"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.avi\shell\ConvertIO"
!macroend
